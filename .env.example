# ---- Variables PUBLIQUES (préfixe VITE_ : visibles dans le navigateur) ----
# Supabase → Project Settings → API (Project URL et clé "publishable")
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Variables SECRÈTES (jamais de préfixe VITE_ : uniquement côté serveur) ----
# IA de lecture des tickets (API compatible OpenAI), utilisée par api/extract.js
JEDHA_AI_API_KEY=
JEDHA_AI_BASE_URL=
# Optionnel, par défaut : openai/gpt-4.1-mini
JEDHA_AI_MODEL=

# Les 5 variables ci-dessus sont à recréer dans Vercel (Settings → Environment Variables).
# Rien pour n8n ici : le secret du webhook vit uniquement dans Supabase (webhook de base de données)
# et dans n8n. L'app n'appelle jamais n8n.
